<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared App Group: the widget reads the complication summary the watch app writes here
	     (BUILD_SPEC §5.1/§5.3). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.nursetimer.app</string>
	</array>
</dict>
</plist>
